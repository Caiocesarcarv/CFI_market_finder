# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser versionado (já está no .gitignore).

# Servidor local
APP_HOST=127.0.0.1
APP_PORT=8000

# Banco SQLite (caminho relativo à raiz do projeto)
DATABASE_PATH=data/cfi_market_finder.db

# UN Comtrade - https://comtradedeveloper.un.org (chave da assinatura "comtrade - v1")
# O nome antigo UNCOMTRADE_KEY também é aceito.
COMTRADE_API_KEY=chave_comtrade

# Groq - https://console.groq.com/keys
GROQ_API_KEY=chave_groq
GROQ_MODEL=openai/gpt-oss-120b

# Comex Stat (https://api-comexstat.mdic.gov.br) é público e não exige chave.
